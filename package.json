{
  "name": "jaeger",
  "private": true,
  "version": "0.1.0",
  "description": "Unified media management system",
  "scripts": {
    "dev": "bun run --filter \"./packages/**\" dev",
    "build": "bun run --filter \"./packages/**\" build",
    "typecheck": "bun run --filter \"./packages/**\" typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "bun run --filter \"./packages/**\" clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.15",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
