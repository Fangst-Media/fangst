    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "operationId": "get_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not the owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "description": "Replaces every setting. Servers, categories, notifiers and adapters change at once; the response says what waits for a restart. Passwords and tokens left out or `null` stay as stored.",
        "operationId": "put_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSettings"
                }
              }
            }
          },
          "400": {
            "description": "A setting is invalid or set by the environment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not the owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddJobLink": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AddJobUrl"
          },
          {
            "$ref": "#/components/schemas/AddJobMagnet"
          }
        ],
        "description": "The JSON forms of `POST /api/v1/jobs`: exactly one of `url` or `magnet`."
      },
      "AddJobMagnet": {
        "type": "object",
        "description": "A torrent by magnet link. Only links with a v1 (`btih`) info hash are accepted.",
        "required": [
          "magnet"
        ],
        "properties": {
          "magnet": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddJobUrl": {
        "type": "object",
        "description": "An NZB or `.torrent` for the daemon to download itself.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "`http` or `https`; redirects are followed only to `http` and `https`, except that a\nredirect to a magnet link adds that link. A `magnet:` link here is added as one."
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CategoryChange": {
        "type": "object",
        "description": "The category to move a job to; `null` for none.",
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CategorySettings": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "folder": {
            "type": [
              "string",
              "null"
            ],
            "description": "Folder for the category's new jobs; relative paths are inside the downloads folder."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ChangeDto": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "job",
              "type"
            ],
            "properties": {
              "job": {
                "$ref": "#/components/schemas/JobDto"
              },
              "type": {
                "type": "string",
                "enum": [
                  "updated"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "deleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Sent about once a second for each downloading job.",
            "required": [
              "id",
              "downloaded_bytes",
              "rate_bytes_per_sec",
              "type"
            ],
            "properties": {
              "downloaded_bytes": {
                "type": "integer",
                "format": "int64"
              },
              "eta_seconds": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "`null` while the rate or the size is unknown."
              },
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "rate_bytes_per_sec": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "progress"
                ]
              }
            }
          }
        ],
        "description": "A message on the event stream."
      },
      "DiscordSettings": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "has_webhook_url": {
            "type": "boolean"
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only, since the URL carries the token that lets anyone post. `\"\"` removes it."
          },
          "webhook_url_env": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EventDto": {
        "type": "object",
        "required": [
          "at",
          "kind",
          "message"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix seconds."
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FolderSettings": {
        "type": "object",
        "required": [
          "downloads"
        ],
        "properties": {
          "downloads": {
            "type": "string",
            "description": "Where jobs download to. Relative paths are inside the data folder. Takes a restart."
          },
          "media": {
            "type": [
              "string",
              "null"
            ],
            "description": "The media library the downloads are moved or linked into, if any."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "JobDto": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "priority",
          "status",
          "total_bytes",
          "downloaded_bytes",
          "rate_bytes_per_sec",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix seconds."
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "downloaded_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes on disk. Live while the job downloads, otherwise as last recorded; a completed job\ncounts as `total_bytes`."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the job failed, when it did."
          },
          "eta_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Seconds left at the current rate; `null` when not downloading or not yet known."
          },
          "finished_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "name": {
            "type": "string"
          },
          "output_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "format": "int64"
          },
          "rate_bytes_per_sec": {
            "type": "integer",
            "format": "int64",
            "description": "Averaged over the last few seconds; 0 unless the job is downloading."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "usenet",
          "torrent"
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "downloading",
          "paused",
          "completed",
          "failed"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NotifierSettings": {
        "type": "object",
        "required": [
          "webhook",
          "ntfy",
          "discord"
        ],
        "properties": {
          "discord": {
            "$ref": "#/components/schemas/DiscordSettings"
          },
          "ntfy": {
            "$ref": "#/components/schemas/NtfySettings"
          },
          "webhook": {
            "$ref": "#/components/schemas/WebhookSettings"
          }
        }
      },
      "NtfySettings": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "has_token": {
            "type": "boolean"
          },
          "server": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` for the default server."
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only access token for protected topics. `\"\"` removes it."
          },
          "token_env": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PasswordChange": {
        "type": "object",
        "required": [
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required once the user has a password."
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "ProviderSettings": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "enabled"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`api_adapter` or `post_processor`."
          },
          "required": {
            "type": "boolean",
            "description": "Read-only: on whatever the request says, because the daemon or a flag needs it."
          }
        }
      },
      "SavedSettings": {
        "type": "object",
        "required": [
          "settings",
          "restart_required",
          "restart_reasons"
        ],
        "properties": {
          "restart_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What waits for the restart, in words."
          },
          "restart_required": {
            "type": "boolean",
            "description": "Some changes only take effect after the daemon restarts."
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsDto"
          }
        }
      },
      "ServerSettings": {
        "type": "object",
        "required": [
          "name",
          "host",
          "port",
          "tls",
          "connections",
          "enabled"
        ],
        "properties": {
          "backfill": {
            "type": "boolean",
            "description": "Only asked for segments every primary server is missing."
          },
          "connections": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "has_password": {
            "type": "boolean",
            "description": "Read-only: whether a password is stored or comes from `password_env`."
          },
          "host": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Keeps the stored password with the server across renames. `null` for a new server."
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only. Leave out or `null` to keep the stored password, `\"\"` to remove it."
          },
          "password_env": {
            "type": [
              "string",
              "null"
            ],
            "description": "Environment variable to read the password from instead."
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "priority": {
            "type": "integer",
            "format": "int64",
            "description": "Lower is tried first."
          },
          "source": {
            "$ref": "#/components/schemas/SettingSource",
            "description": "Read-only. Servers not from the file can't be changed here and are ignored in requests."
          },
          "tls": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ServerTestRequest": {
        "type": "object",
        "description": "A usenet server to try. Nothing is saved.",
        "required": [
          "host",
          "port"
        ],
        "properties": {
          "connections": {
            "type": "integer",
            "description": "How many connections to open at once; use the count you plan to configure.",
            "minimum": 0
          },
          "host": {
            "type": "string"
          },
          "password": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tls": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ServerTestResult": {
        "type": "object",
        "required": [
          "ok",
          "message",
          "connections_accepted",
          "connections_requested"
        ],
        "properties": {
          "cause": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable name of what went wrong: `dns`, `refused`, `timeout`, `tls`, `network`,\n`auth_failed`, `auth_required`, `unavailable`, `protocol` or `connection_limit`."
          },
          "connections_accepted": {
            "type": "integer",
            "minimum": 0
          },
          "connections_requested": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "description": "What happened, in words a user can act on. Never contains the password."
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "SettingSource": {
        "type": "string",
        "enum": [
          "file",
          "environment",
          "flags"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "description": "Every setting the web UI manages.",
        "required": [
          "folders",
          "servers",
          "categories",
          "notifiers",
          "torrent",
          "providers"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategorySettings"
            }
          },
          "folders": {
            "$ref": "#/components/schemas/FolderSettings"
          },
          "locked": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Dotted names, such as `torrent.listen_port`, of settings an environment variable or a\ncommand-line flag sets. Ignored in requests; a request that changes one is refused."
          },
          "notifiers": {
            "$ref": "#/components/schemas/NotifierSettings"
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderSettings"
            },
            "description": "Adapters and post-processors; notifiers are switched on under `notifiers`."
          },
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerSettings"
            },
            "description": "In the order they are tried; `priority` sorts them first."
          },
          "torrent": {
            "$ref": "#/components/schemas/TorrentSettings"
          }
        }
      },
      "TorrentFileDto": {
        "type": "object",
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "description": "Relative to the job folder, with `/` between folders."
          }
        }
      },
      "TorrentSettings": {
        "type": "object",
        "description": "The torrent engine. Every change here takes a restart.",
        "required": [
          "enabled",
          "listen_port",
          "dht",
          "local_discovery",
          "upnp",
          "max_active"
        ],
        "properties": {
          "announce_port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "`null` to announce `listen_port`.",
            "minimum": 0
          },
          "dht": {
            "type": "boolean"
          },
          "download_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Bytes per second; `null` for no limit.",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "listen_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "local_discovery": {
            "type": "boolean"
          },
          "max_active": {
            "type": "integer",
            "minimum": 0
          },
          "upload_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "upnp": {
            "type": "boolean"
          }
        }
      },
      "TorrentStatusDto": {
        "type": "object",
        "description": "A torrent job's hash, files and live progress.",
        "required": [
          "info_hash",
          "files",
          "have_bytes",
          "uploaded_bytes",
          "download_bps",
          "upload_bps"
        ],
        "properties": {
          "download_bps": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes per second; 0 while not running.",
            "minimum": 0
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TorrentFileDto"
            },
            "description": "Empty until the metadata is known, which for a magnet link means until a peer sends it."
          },
          "have_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes on disk that passed the hash check.",
            "minimum": 0
          },
          "info_hash": {
            "type": "string",
            "description": "Lowercase hex of the v1 info hash."
          },
          "upload_bps": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "uploaded_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes sent to peers since the torrent started in this run.",
            "minimum": 0
          }
        }
      },
      "UserDto": {
        "type": "object",
        "required": [
          "id",
          "username",
          "has_password"
        ],
        "properties": {
          "has_password": {
            "type": "boolean",
            "description": "False for a user who can only sign in with an API key so far."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "WebhookSettings": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "has_token": {
            "type": "boolean"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Write-only bearer token. Leave out or `null` to keep it, `\"\"` to remove it."
          },
          "token_env": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "`http` or `https`; every event is posted to it as JSON."
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fangst_session"
      }
    }
  },
  "security": [
    {
      "api_key": []
    },
    {
      "session": []
    }
  ]
}
