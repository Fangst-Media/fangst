{
  "openapi": "3.1.0",
  "info": {
    "title": "Fangst download daemon",
    "description": "Native API of fangst-dl.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Sets an HttpOnly session cookie. Repeated failures from one address are slowed down with 429 and `Retry-After`.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Too many password checks at once; retry after `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Ends the session in the cookie, if any, and clears the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {}
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password": {
      "put": {
        "tags": [
          "auth"
        ],
        "description": "Sets the caller's password and ends their other sessions. A caller signed in with a session gets a fresh session cookie.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The current password is wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [],
        "description": "WebSocket. Each message is a `ChangeDto` as JSON. Browsers pass the key as `?api_key=`.",
        "operationId": "events",
        "responses": {
          "101": {
            "description": "Switching to WebSocket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": [],
        "operationId": "list_jobs",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobDto"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "operationId": "add_job",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Shown in the queue; defaults to the NZB's title or the torrent's name.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Higher runs first.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "magnet",
            "in": "query",
            "description": "A magnet link to add instead of a request body.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "An NZB file, a `.torrent` file, or JSON naming a URL to fetch either from or a magnet link. With `?magnet=` the body is ignored. Without `name` the job is named after the NZB's title or the torrent's name, then the file name in the URL.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddJobLink"
              }
            },
            "application/x-bittorrent": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            },
            "application/x-nzb": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "400": {
            "description": "The JSON is invalid, or the URL is invalid or not http(s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The same torrent is already a job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Not a valid NZB, torrent or magnet link, or the fetched file is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "The URL could not be fetched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": [],
        "operationId": "get_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [],
        "operationId": "delete_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "delete_files",
            "in": "query",
            "description": "Also remove the job's folder and everything downloaded into it.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/pause": {
      "post": {
        "tags": [],
        "operationId": "pause_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/resume": {
      "post": {
        "tags": [],
        "operationId": "resume_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/timeline": {
      "get": {
        "tags": [],
        "operationId": "job_timeline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventDto"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/test": {
      "post": {
        "tags": [],
        "description": "Connects with every requested connection at once and logs in. A failed test is still a 200; read `ok` and `cause`.",
        "operationId": "test_server",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerTestResult"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddJobLink": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AddJobUrl"
          },
          {
            "$ref": "#/components/schemas/AddJobMagnet"
          }
        ],
        "description": "The JSON forms of `POST /api/v1/jobs`: exactly one of `url` or `magnet`."
      },
      "AddJobMagnet": {
        "type": "object",
        "description": "A torrent by magnet link. Only links with a v1 (`btih`) info hash are accepted.",
        "required": [
          "magnet"
        ],
        "properties": {
          "magnet": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddJobUrl": {
        "type": "object",
        "description": "An NZB or `.torrent` for the daemon to download itself.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "`http` or `https`; redirects are followed only to `http` and `https`, except that a\nredirect to a magnet link adds that link. A `magnet:` link here is added as one."
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ChangeDto": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "job",
              "type"
            ],
            "properties": {
              "job": {
                "$ref": "#/components/schemas/JobDto"
              },
              "type": {
                "type": "string",
                "enum": [
                  "updated"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "deleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Sent about once a second for each downloading job.",
            "required": [
              "id",
              "downloaded_bytes",
              "rate_bytes_per_sec",
              "type"
            ],
            "properties": {
              "downloaded_bytes": {
                "type": "integer",
                "format": "int64"
              },
              "eta_seconds": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "description": "`null` while the rate or the size is unknown."
              },
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "rate_bytes_per_sec": {
                "type": "integer",
                "format": "int64"
              },
              "type": {
                "type": "string",
                "enum": [
                  "progress"
                ]
              }
            }
          }
        ],
        "description": "A message on the event stream."
      },
      "EventDto": {
        "type": "object",
        "required": [
          "at",
          "kind",
          "message"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix seconds."
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "JobDto": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "priority",
          "status",
          "total_bytes",
          "downloaded_bytes",
          "rate_bytes_per_sec",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix seconds."
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "downloaded_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes on disk. Live while the job downloads, otherwise as last recorded; a completed job\ncounts as `total_bytes`."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the job failed, when it did."
          },
          "eta_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Seconds left at the current rate; `null` when not downloading or not yet known."
          },
          "finished_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "name": {
            "type": "string"
          },
          "output_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "format": "int64"
          },
          "rate_bytes_per_sec": {
            "type": "integer",
            "format": "int64",
            "description": "Averaged over the last few seconds; 0 unless the job is downloading."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "usenet",
          "torrent"
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "downloading",
          "paused",
          "completed",
          "failed"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "PasswordChange": {
        "type": "object",
        "required": [
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required once the user has a password."
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "ServerTestRequest": {
        "type": "object",
        "description": "A usenet server to try. Nothing is saved.",
        "required": [
          "host",
          "port"
        ],
        "properties": {
          "connections": {
            "type": "integer",
            "description": "How many connections to open at once; use the count you plan to configure.",
            "minimum": 0
          },
          "host": {
            "type": "string"
          },
          "password": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tls": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ServerTestResult": {
        "type": "object",
        "required": [
          "ok",
          "message",
          "connections_accepted",
          "connections_requested"
        ],
        "properties": {
          "cause": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable name of what went wrong: `dns`, `refused`, `timeout`, `tls`, `network`,\n`auth_failed`, `auth_required`, `unavailable`, `protocol` or `connection_limit`."
          },
          "connections_accepted": {
            "type": "integer",
            "minimum": 0
          },
          "connections_requested": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "description": "What happened, in words a user can act on. Never contains the password."
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "required": [
          "id",
          "username",
          "has_password"
        ],
        "properties": {
          "has_password": {
            "type": "boolean",
            "description": "False for a user who can only sign in with an API key so far."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fangst_session"
      }
    }
  },
  "security": [
    {
      "api_key": []
    },
    {
      "session": []
    }
  ]
}
