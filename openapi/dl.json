                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/test": {
      "post": {
        "tags": [],
        "description": "Connects with every requested connection at once and logs in. A failed test is still a 200; read `ok` and `cause`.",
        "operationId": "test_server",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
