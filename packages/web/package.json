{
  "name": "@jaeger/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:css & bun run dev:server",
    "dev:server": "bun run server.ts",
    "dev:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --watch",
    "build": "bun run build:css && bun build src/main.tsx --outdir ./dist --target browser --minify --sourcemap",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jaeger/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-router": "^1.91.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
