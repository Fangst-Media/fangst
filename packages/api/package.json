{
  "name": "@fangst/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "db:push": "mkdir -p data && drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "generate:openapi": "bun run src/scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.4",
    "@hono/zod-validator": "^0.7.6",
    "@fangst/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.6",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.12.10",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "rotating-file-stream": "^3.2.7",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
