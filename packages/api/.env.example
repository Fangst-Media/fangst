PORT=5001
DATABASE_URL=./data/jaeger.db
CORS_ORIGIN=http://localhost:5173

# Mock filesystem for development (loads from src/tests/fixtures/mock-filesystem.json)
MOCK_FILESYSTEM=true

# Media library path (ignored if MOCK_FILESYSTEM=true)
MEDIA_PATH=/media

# Metadata providers (comma-separated, in priority order)
# Options: relay, tmdb, tvdb
# Default: relay,tmdb,tvdb
METADATA_PROVIDERS=relay,tmdb,tvdb

# Metadata Relay (no key needed)
METADATA_RELAY_URL=https://metadata-relay.dorninger.co

# TMDB (requires API key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-api-key-here

# TVDB (requires API key from https://thetvdb.com/dashboard/account/apikeys)
TVDB_API_KEY=your-api-key-here

# Authentication
# Jellyfin server URL
JELLYFIN_URL=http://localhost:8096

# Sync admin status from auth provider (true/false)
SYNC_ADMIN_FROM_PROVIDER=true

# Session expiry in days
SESSION_EXPIRY_DAYS=30
